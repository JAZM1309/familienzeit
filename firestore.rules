rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(familyId) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(familyId)/members/$(request.auth.uid));
    }
    match /families/{familyId} {
      allow read: if isMember(familyId);
      allow write: if false; // Familienanlage nur über vertrauenswürdige Admin-/Cloud-Funktion
      match /members/{uid} {
        allow read: if isMember(familyId);
        allow write: if false;
      }
      match /{collectionName}/{itemId} {
        allow read: if isMember(familyId);
        allow create: if isMember(familyId) && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if isMember(familyId) && resource.data.createdBy == request.auth.uid;
      }
    }
    match /users/{uid}/memberships/{membershipId} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }
    match /invites/{inviteId} {
      allow read, write: if false; // Einladungen ausschließlich serverseitig prüfen/verbrauchen
    }
  }
}
